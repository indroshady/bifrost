{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/insen_microsoft/bifrost/spec/schema/bifrost.schema.json",
  "title": "Bifrost Core v0.2 selected configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design",
    "parameters",
    "mesh",
    "flit",
    "virtual_channels",
    "arbitration",
    "flow_control",
    "external_interface",
    "clock",
    "reset"
  ],
  "properties": {
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spec_revision", "profile"],
      "properties": {
        "name": {"const": "bifrost_router"},
        "spec_revision": {"const": "0.2"},
        "profile": {"const": "core_v0_2"}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PORTS",
        "FLIT_W",
        "NUM_VCS",
        "VC_DEPTH",
        "X_W",
        "Y_W",
        "ROUTER_X",
        "ROUTER_Y",
        "MESH_X",
        "MESH_Y",
        "PKT_ID_W",
        "PORT_ID_W",
        "VC_ID_W",
        "QOS_W",
        "QOS_CLASSES",
        "QOS_WEIGHTS"
      ],
      "properties": {
        "PORTS": {"const": 5},
        "FLIT_W": {"const": 128},
        "NUM_VCS": {"const": 2},
        "VC_DEPTH": {"const": 4},
        "X_W": {"const": 1},
        "Y_W": {"const": 1},
        "ROUTER_X": {"const": 0},
        "ROUTER_Y": {"const": 0},
        "MESH_X": {"const": 2},
        "MESH_Y": {"const": 2},
        "PKT_ID_W": {"const": 16},
        "PORT_ID_W": {"const": 3},
        "VC_ID_W": {"const": 1},
        "QOS_W": {"const": 2},
        "QOS_CLASSES": {"const": 1},
        "QOS_WEIGHTS": {
          "type": "array",
          "prefixItems": [{"const": 1}],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ports",
        "port_encoding",
        "routing",
        "north_is_increasing_y",
        "dimensions",
        "router_coordinate"
      ],
      "properties": {
        "ports": {
          "type": "array",
          "prefixItems": [
            {"const": "local"},
            {"const": "north"},
            {"const": "south"},
            {"const": "east"},
            {"const": "west"}
          ],
          "minItems": 5,
          "maxItems": 5
        },
        "port_encoding": {
          "const": {
            "width_bits": 3,
            "values": {
              "local": 0,
              "north": 1,
              "south": 2,
              "east": 3,
              "west": 4
            },
            "invalid_values": [5, 6, 7]
          }
        },
        "routing": {"const": "deterministic_xy"},
        "north_is_increasing_y": {"const": true},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {"const": 2},
            "y": {"const": 2}
          }
        },
        "router_coordinate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {"const": 0},
            "y": {"const": 0}
          }
        }
      }
    },
    "flit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_bits",
        "packet_id_width_bits",
        "packet_mode",
        "encoding_frozen",
        "payload_width_bits",
        "fields"
      ],
      "properties": {
        "width_bits": {"const": 128},
        "packet_id_width_bits": {"const": 16},
        "packet_mode": {"const": "wormhole"},
        "encoding_frozen": {"const": true},
        "payload_width_bits": {"type": "integer", "minimum": 1},
        "fields": {
          "const": {
            "head": {
              "msb": 127,
              "lsb": 127,
              "width_bits": 1,
              "meaningful_on": "all_flits"
            },
            "tail": {
              "msb": 126,
              "lsb": 126,
              "width_bits": 1,
              "meaningful_on": "all_flits"
            },
            "destination_x": {
              "msb": 125,
              "lsb": 125,
              "width_bits": 1,
              "meaningful_on": "headers_only"
            },
            "destination_y": {
              "msb": 124,
              "lsb": 124,
              "width_bits": 1,
              "meaningful_on": "headers_only"
            },
            "source_x": {
              "msb": 123,
              "lsb": 123,
              "width_bits": 1,
              "meaningful_on": "headers_only"
            },
            "source_y": {
              "msb": 122,
              "lsb": 122,
              "width_bits": 1,
              "meaningful_on": "headers_only"
            },
            "packet_id": {
              "msb": 121,
              "lsb": 106,
              "width_bits": 16,
              "meaningful_on": "headers_only"
            },
            "qos_class": {
              "msb": 105,
              "lsb": 104,
              "width_bits": 2,
              "meaningful_on": "headers_only"
            },
            "payload": {
              "msb": 103,
              "lsb": 0,
              "width_bits": 104,
              "meaningful_on": "all_flits"
            }
          }
        }
      }
    },
    "virtual_channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count_per_input", "depth_flits", "id_encoding"],
      "properties": {
        "count_per_input": {"const": 2},
        "depth_flits": {"const": 4},
        "id_encoding": {
          "const": {
            "width_bits": 1,
            "values": {"vc0": 0, "vc1": 1},
            "invalid_values": []
          }
        }
      }
    },
    "arbitration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "switch_policy",
        "granularity",
        "qos_enabled",
        "qos_classes",
        "qos_weights",
        "aging_enabled"
      ],
      "properties": {
        "switch_policy": {"const": "round_robin"},
        "granularity": {"const": "per_flit"},
        "qos_enabled": {"const": false},
        "qos_classes": {"const": 1},
        "qos_weights": {
          "type": "array",
          "prefixItems": [{"const": 1}],
          "minItems": 1,
          "maxItems": 1
        },
        "aging_enabled": {"const": false}
      }
    },
    "flow_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allow_same_cycle_zero_credit_bypass"],
      "properties": {
        "mode": {"const": "registered_credit"},
        "allow_same_cycle_zero_credit_bypass": {"const": false}
      }
    },
    "external_interface": {
      "const": {
        "port_array_order": "mesh.ports",
        "port_dimension": "unpacked",
        "data_dimensions": "packed",
        "transfer_edge": "rising",
        "has_rx_ready": false,
        "has_tx_ready": false,
        "signals": {
          "clk": {"direction": "input", "shape": [1]},
          "rst_n": {"direction": "input", "shape": [1]},
          "port_enable": {"direction": "input", "shape": ["PORTS"]},
          "rx_valid": {"direction": "input", "shape": ["PORTS"]},
          "rx_flit": {"direction": "input", "shape": ["PORTS", "FLIT_W"]},
          "rx_vc": {"direction": "input", "shape": ["PORTS", "VC_ID_W"]},
          "tx_valid": {"direction": "output", "shape": ["PORTS"]},
          "tx_flit": {"direction": "output", "shape": ["PORTS", "FLIT_W"]},
          "tx_vc": {"direction": "output", "shape": ["PORTS", "VC_ID_W"]},
          "credit_out_valid": {"direction": "output", "shape": ["PORTS"]},
          "credit_out_vc": {"direction": "output", "shape": ["PORTS", "VC_ID_W"]},
          "credit_in_valid": {"direction": "input", "shape": ["PORTS"]},
          "credit_in_vc": {"direction": "input", "shape": ["PORTS", "VC_ID_W"]}
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_period_ns"],
      "properties": {
        "target_period_ns": {"const": 2.0}
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_level", "style", "coordinated_links"],
      "properties": {
        "active_level": {"const": "low"},
        "style": {"const": "synchronous"},
        "coordinated_links": {"const": true}
      }
    }
  }
}
